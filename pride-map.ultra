---
type: geojson
options:
  attributionControl:
    customAttribution: '<a href=".">Ultra</a> | <a href="https://github.com/Lumikeiju/pride-map">Github</a>'
controls:
  - type: GeolocateControl
    options:
      positionOptions:
        enableHighAccuracy: true
      trackUserLocation: true
transform: |
  const keyPattern =
    /^(lgbtq(?::.*)?|non_binary.*|(male|female):transgender)$/i;
  const valuePriority = ["only", "primary", "welcome"];

  export default function (data) {
    for (const feature of data.features) {
      const properties = feature.properties ?? {};
      const value = valuePriority.find((candidate) =>
        Object.entries(properties).some(
          ([key, rawValue]) =>
            keyPattern.test(key) &&
            String(rawValue).toLowerCase() === candidate
        )
      );

      properties.__pride_map_value = value ?? "other";
      feature.properties = properties;
    }

    return data;
  }
style:
  extends: https://styles.trailsta.sh/protomaps-grayscale.json
  layers:
    - type: symbol
      icon-image:
        - match
        - [get, __pride_map_value]
        - only
        - https://lumikeiju.dev/pride-map/icons/osmheart_lgbtq_horizontal_24px.png
        - primary
        - https://lumikeiju.dev/pride-map/icons/osmheart_lgbtq_slanted_24px.png
        - welcome
        - https://lumikeiju.dev/pride-map/icons/osmpin_lgbtq_slanted_24px.png
        - https://lumikeiju.dev/pride-map/icons/osmpin_lgbtq_horizontal_24px.png
      icon-allow-overlap: true
      icon-anchor: bottom
      text-field: '{name}'
      text-optional: true
      text-anchor: top
      text-size: 12
      text-color: black
      text-halo-width: 1.5
      text-halo-color: white
---
https://lumikeiju.dev/pride-map/data.geojson
